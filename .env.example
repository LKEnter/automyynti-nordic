# Production Routing Environment Variables
NEXT_PUBLIC_SITE_URL=https://my-client-site.fi
NEXT_PUBLIC_SITE_ID=your_unique_tenant_site_id_here

# Admin bootstrap (used by prisma/seed.ts)
MORFOOS_ADMIN_SECRET=your_admin_secret_here
MORFOOS_ADMIN_EMAIL=admin@example.fi
MORFOOS_ADMIN_PASSWORD=change-me-before-production

# Core Database Configuration
DATABASE_URL=mysql://user:password@localhost:3306/morfoos
