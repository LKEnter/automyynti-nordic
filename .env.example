# Public Routing & Multi-Tenancy Scoping
NEXT_PUBLIC_SITE_URL="https://my-client-site.fi"
NEXT_PUBLIC_SITE_ID="site_playground"

# Security (Cookie Signing Key)
MORFOOS_AUTH_SECRET="a_very_long_random_string_that_is_totally_secret"

# The Initial Seeding Credentials (Only used when running npx prisma db seed)
MORFOOS_ADMIN_EMAIL="admin@clientname.fi"
MORFOOS_ADMIN_PASSWORD="super-secure-temporary-password"

# Infrastructure Connection
DATABASE_URL="mysql://user:password@localhost:3306/morfoos"
